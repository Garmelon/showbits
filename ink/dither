#!/usr/bin/env python3

import argparse
import subprocess

PALETTE = ["white", "black", "rgb(200,0,0)"]

parser = argparse.ArgumentParser()
args = parser.parse_args()

subprocess.run(
    [
        "magick",
        "-",
        *["(", *(f"xc:{color}" for color in PALETTE), "+append"],
        *["-write", "mpr:palette", "+delete", ")"],
        *["-dither", "FloydSteinberg", "-remap", "mpr:palette"],
        "png:-",
    ],
    check=True,
)
