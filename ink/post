#!/usr/bin/env python3

import argparse
import subprocess

parser = argparse.ArgumentParser()
parser.add_argument("url")
args = parser.parse_args()

subprocess.run(
    [
        "curl",
        *["--silent", "--show-error", "--fail-with-body"],
        *["--form", "image=@-"],
        args.url,
    ],
    check=True,
)
