#!/usr/bin/env fish

function heading
    set -l border (string repeat -n (string length $argv) '#')
    echo
    set_color --bold yellow
    echo "##$border##"
    echo "# $argv #"
    echo "##$border##"
    set_color normal
end

if test (count $argv) -ne 2
    echo "Usage:" (status filename) "<user> <host>"
    exit 1
end

set -l USER $argv[1]
set -l HOST $argv[2]

set -l TARGET arm-unknown-linux-gnueabihf
set -l SERVICE showbits-ink.service
set -l SERVICE_FILE "\
[Unit]
Description=Showbits E-Ink Display

[Service]
Type=simple
ExecStart=%h/showbits-ink -a 0.0.0.0:8080 -Q queue
# ExecStart=%h/showbits-ink -a 0.0.0.0:8080 -Q queue -A archive
Restart=on-failure
WorkingDirectory=%h

[Install]
WantedBy=default.target"

heading "Compile binary"
cross build --bin showbits-ink --release --target $TARGET
or exit 1

heading "Stop service"
ssh $USER@$HOST "systemctl --user stop $SERVICE"

heading "Copy binary"
rsync -P target/$TARGET/release/showbits-ink $USER@$HOST:
or exit 1

heading "Install service"
echo $SERVICE_FILE | ssh $USER@$HOST "\
mkdir -p ~/.config/systemd/user \
&& cat > ~/.config/systemd/user/$SERVICE \
"
or exit 1

heading "Start service"
ssh $USER@$HOST "\
systemctl --user daemon-reload \
&& systemctl --user enable $SERVICE \
&& systemctl --user start $SERVICE \
"
or exit 1
